{
	"folders": [
		{
			"name": "Comparador Alfa vs Omega (Frontend)",
			"path": "."
		},
		{
			"name": "Weekly Tasks (Frontend)",
			"path": "projects/weekly-tasks"
		},
		{
			"name": "Weekly Tasks (Backend)",
			"path": "weekly-tasks-backend"
		}
	],
	"settings": {
		"java.configuration.updateBuildConfiguration": "automatic",
		"spring-boot.ls.problem.boot2.JAVA_CONSTRUCTOR_PARAMETER_INJECTION": "WARNING"
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"type": "java",
				"name": "Spring Boot - Weekly Tasks Backend",
				"request": "launch",
				"cwd": "${workspaceFolder:Weekly Tasks (Backend)}",
				"mainClass": "com.tibia.weeklytasks.WeeklyTasksApplication",
				"projectName": "weekly-tasks-backend",
				"args": "--spring.profiles.active=local"
			}
		]
	}
}