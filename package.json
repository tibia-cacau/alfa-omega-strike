{
  "name": "tibia-cacau",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve shell --port 4300",
    "build": "ng build shell",
    "watch": "ng build shell --watch --configuration development",
    "test": "ng test shell",
    "deploy": "ng build shell --base-href \"https://tibia-cacau.github.io/alfa-omega-strike/\" && npx angular-cli-ghpages --dir=dist/shell",
    "start:weekly": "ng serve weekly-tasks --port 4201",
    "build:weekly": "ng build weekly-tasks --configuration production",
    "deploy:weekly": "ng build weekly-tasks --configuration production --base-href \"https://tibia-cacau.github.io/tibia-weekly-task/\" && npx angular-cli-ghpages --dir=dist/weekly-tasks --repo=https://github.com/tibia-cacau/tibia-weekly-task.git"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.12",
    "@angular/cdk": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/material": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "ng2-charts": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.12",
    "@angular/cli": "^16.2.12",
    "@angular/compiler-cli": "^16.2.0",
    "@types/jasmine": "~4.3.0",
    "angular-cli-ghpages": "^2.0.1",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.1.3"
  }
